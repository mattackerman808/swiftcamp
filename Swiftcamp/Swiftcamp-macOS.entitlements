<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime withholds Location Services without this,
	     silently: the locate button would never prompt and never answer.
	     See Map/Locator.swift. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
